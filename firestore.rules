rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Replace with actual admin UID from Firebase Auth
    function isAdmin() {
      return request.auth != null &&
             request.auth.uid == "REPLACE_WITH_ADMIN_UID";
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Products
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Stock transactions
    match /stockTransactions/{txId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if false; // immutable ledger
    }

    // Assets
    match /assets/{assetId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Asset assignments
    match /assetAssignments/{assignId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Employees
    match /employees/{empId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Invoices (Zoho imports)
    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Repairs
    match /repairs/{repairId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Audit log — write once, read only
    match /auditLog/{logId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Categories
    match /categories/{catId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
